[Desktop Entry]
Type=Application
Name=pyReader
Comment=EPUB reader that lives on your desktop
# "~", not "$HOME": systemd's autostart generator escapes "$", so sh would never expand it
Exec=sh -c "exec ~/.local/share/pyreader/launch.sh"
Icon=accessories-ebook-reader
Terminal=false
Categories=Office;Viewer;
X-KDE-autostart-after=panel
X-GNOME-Autostart-enabled=true
